---
import Eyebrow from "../components/Eyebrow.astro";
import ArrowButton from "../components/ArrowButton.astro";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = ui[locale].pricing;
---

<section class="pricing on-dark" id="pricing" aria-labelledby="pricing-title">
  <div class="container">
    <div class="pricing-head">
      <Eyebrow dark center>{t.eyebrow}</Eyebrow>
      <h2 id="pricing-title" class="display-sm" data-lines>
        {t.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h2>
      <p class="sub" data-reveal>{t.sub}</p>
    </div>

    <div class="pricing-cards" data-pricing-cards>
      {t.plans.map((plan) => (
        <article class:list={["plan", plan.featured && "featured"]}>
          <div class="plan-top">
            <p class="plan-kicker">{plan.kicker}</p>
            {plan.badge && <span class="plan-badge">{plan.badge}</span>}
          </div>
          <h3 class="plan-name">{plan.name}</h3>
          <p class="plan-price">
            <span class="currency">$</span>{plan.price}
            <span class="per">/mes</span>
          </p>
          <p class="plan-blurb">{plan.blurb}</p>
          <ul class="plan-features">
            {plan.features.map((feature) => (
              <li>
                <svg
                  class="check"
                  data-check
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m5 13 4.5 4.5L19 7"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    pathLength="1"
                  />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <div class="plan-cta">
            <ArrowButton
              href="#cta"
              variant={plan.featured ? "lime" : "primary"}
              label={plan.cta}
            />
          </div>
        </article>
      ))}
    </div>

    <p class="note" data-reveal>{t.currencyNote}</p>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    padding: var(--section-space) 0;
    background: var(--reviko-green-deep);
    color: var(--reviko-cream);
    overflow: clip;
  }
  .pricing::before {
    content: "";
    position: absolute;
    inset: -20% -10% auto -10%;
    height: 70%;
    background:
      radial-gradient(
        42% 60% at 18% 40%,
        rgb(199 249 121 / 0.22),
        transparent 70%
      ),
      radial-gradient(
        38% 55% at 82% 20%,
        rgb(30 64 48 / 0.95),
        transparent 72%
      );
    pointer-events: none;
  }
  .pricing::after {
    content: "";
    position: absolute;
    inset: auto -10% -30% 40%;
    height: 60%;
    background: radial-gradient(
      40% 60% at 60% 50%,
      rgb(199 249 121 / 0.16),
      transparent 70%
    );
    pointer-events: none;
  }
  .pricing > .container { position: relative; z-index: 1; }

  .pricing-head {
    display: grid;
    gap: 1.1rem;
    justify-items: center;
    text-align: center;
  }
  .pricing .display-sm { color: var(--reviko-cream); max-width: 20ch; }
  .sub {
    color: rgb(252 249 243 / 0.75);
    max-width: 42rem;
    font-size: 1.05rem;
  }

  .pricing-cards {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    gap: 1.1rem;
    align-items: stretch;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    background: var(--reviko-card);
    color: var(--reviko-ink);
    border: 1px solid rgb(11 42 29 / 0.12);
    border-radius: var(--radius-lg);
    padding: 1.7rem 1.6rem 1.6rem;
    box-shadow: var(--shadow-card);
    transition:
      transform 0.3s var(--ease-out),
      box-shadow 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
  }
  .plan:hover {
    transform: translateY(-6px);
    border-color: rgb(199 249 121 / 0.9);
    box-shadow:
      0 1px 0 rgb(11 42 29 / 0.06),
      0 26px 54px -28px rgb(0 0 0 / 0.55);
  }
  .plan.featured {
    border-color: var(--reviko-lime);
    box-shadow:
      0 0 0 1px var(--reviko-lime),
      0 26px 54px -28px rgb(0 0 0 / 0.55);
  }
  .plan-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 26px;
  }
  .plan-kicker {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--reviko-sage);
  }
  .plan-badge {
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--reviko-lime);
    color: var(--reviko-green);
    padding: 0.28rem 0.6rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .plan-name {
    font-size: 1.7rem;
    color: var(--reviko-green);
  }
  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
    font-size: clamp(2.6rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--reviko-green);
    line-height: 1;
  }
  .plan-price .currency { font-size: 0.55em; font-weight: 700; }
  .plan-price .per {
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--reviko-sage);
    margin-left: 0.35rem;
  }
  .plan-blurb {
    color: var(--reviko-sage);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .plan-features {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid rgb(11 42 29 / 0.12);
    display: grid;
    gap: 0.7rem;
    flex: 1;
  }
  .plan-features li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--reviko-ink);
  }
  .check {
    color: var(--reviko-lime-deep);
    margin-top: 0.1rem;
    overflow: visible;
  }
  .plan-cta { margin-top: 1.3rem; }
  .plan-cta :global(.btn) { width: 100%; justify-content: center; }
  .plan-cta :global(.btn-primary) {
    background: var(--reviko-green);
    color: var(--reviko-cream);
  }
  .plan-cta :global(.btn-primary:hover) {
    background: var(--reviko-green-2);
  }

  .note {
    margin-top: 1.6rem;
    text-align: center;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgb(252 249 243 / 0.55);
  }

  @media (min-width: 900px) {
    .pricing-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 639px) {
    .pricing .display-sm { max-width: 14ch; }
    .plan { padding: 1.4rem 1.25rem 1.3rem; }
    .plan-price { font-size: 2.5rem; }
  }
</style>
