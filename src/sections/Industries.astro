---
import Eyebrow from "../components/Eyebrow.astro";
import RewardProgress from "../components/RewardProgress.astro";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = ui[locale].industries;
const industries = t.list;

const iconFor = (id: string) =>
  id === "barberia" ? "cut" : id === "autolavado" ? "car" : id === "unas" ? "flower" : id === "restaurante" ? "fork" : "coffee";
---

<section class="industries" id="businesses" aria-labelledby="ind-title">
  <span class="anchor-alias" id="negocios" aria-hidden="true"></span>
  <div class="container">
    <Eyebrow>{t.eyebrow}</Eyebrow>
    <h2 id="ind-title" class="display-sm" data-lines>
      {t.title.map((line) => (
        <span class="line"><span>{line}</span></span>
      ))}
    </h2>
  </div>
  <div class="panels">
    {
      industries.map((ind, i) => (
        <article class:list={["panel", ind.dark && "is-dark", i % 2 === 1 && "flip"]}>
          <div class="container panel-grid">
            <div class="panel-copy">
              <div data-reveal="fade"><Eyebrow dark={ind.dark}>{ind.eyebrow}</Eyebrow></div>
              <h3 data-lines>
                {ind.headline.split(". ").map((part, pi, arr) => (
                  <span class="line"><span>{part}{pi < arr.length - 1 ? "." : ""}</span></span>
                ))}
              </h3>
              <p data-reveal="up">{ind.sub}</p>
              <div class:list={[{ "on-dark": ind.dark }]}>
                <RewardProgress
                  total={ind.stamps.total}
                  filled={ind.stamps.filled}
                  icon={iconFor(ind.id)}
                />
              </div>
            </div>
            <figure class="panel-media" data-media data-parallax={i % 2 ? "5" : "-5"}>
              <img
                src={ind.image}
                alt={`${ind.eyebrow} — ${ind.imageAlt}`}
                loading="lazy"
                decoding="async"
                style={`aspect-ratio: ${ind.ratio}`}
              />
            </figure>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .industries { padding: var(--section-space) 0 0; background: var(--reviko-cream); }
  .industries .container > .display-sm { margin-top: 1rem; }
  .panels { margin-top: 3rem; display: grid; }
  .panel { padding: clamp(3rem, 6vw, 4rem) 0; border-top: 1px solid rgb(11 42 29 / 0.12); }
  .panel.is-dark { background: var(--reviko-green); color: var(--reviko-cream); border-top-color: transparent; }
  .panel-grid { display: grid; gap: 2rem; align-items: center; }
  .panel-copy h3 {
    font-size: clamp(2rem, 4.5vw, 3.8rem);
    margin: 1rem 0;
    color: var(--reviko-green);
  }
  .panel.is-dark .panel-copy h3 { color: var(--reviko-cream); }
  .panel-copy p { color: var(--reviko-sage); margin-bottom: 1.4rem; max-width: 26rem; }
  .panel.is-dark .panel-copy p { color: rgb(252 249 243 / 0.78); }
  .panel-media { margin: 0; overflow: hidden; border-radius: 12px; }
  .panel-media img {
    width: 100%; height: 100%; object-fit: cover;
    border-radius: 12px; border: 1px solid rgb(11 42 29 / 0.14);
    min-height: 280px;
  }
  .panel.is-dark .panel-media img { border-color: rgb(252 249 243 / 0.2); }
  @media (min-width: 980px) {
    .panel-grid { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .panel.flip .panel-copy { order: 2; }
    .panel.flip .panel-media { order: 1; }
  }
  @media (max-width: 639px) {
    .industries { padding-top: var(--section-space); }
    .industries .container > .display-sm { max-width: 14ch; }
    .panels { margin-top: 2rem; }
    .panel { padding: 2.5rem 0; }
    .panel-copy h3 { font-size: clamp(2rem, 9.5vw, 2.85rem); }
    .panel-copy p { margin-bottom: 1rem; }
    .panel-media img { min-height: 0; max-height: 420px; }
  }
</style>
