---
import Eyebrow from "../components/Eyebrow.astro";
import CircleCta from "../components/CircleCta.astro";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = ui[locale].problem;
---

<section class="problem on-dark" aria-labelledby="problem-title">
  <div class="container problem-grid">
    <div>
      <Eyebrow dark>{t.eyebrow}</Eyebrow>
      <h2 id="problem-title" class="display-sm" data-lines>
        {t.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h2>
      <div class="people" data-people aria-hidden="true">
        <div class="person">
          <svg viewBox="0 0 48 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="person-head" cx="24" cy="13" r="11" fill="currentColor"/>
            <path class="person-body" d="M2 62C2 46.5 12 30 24 30C36 30 46 46.5 46 62H2Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="person">
          <svg viewBox="0 0 48 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="person-head" cx="24" cy="13" r="11" fill="currentColor"/>
            <path class="person-body" d="M2 62C2 46.5 12 30 24 30C36 30 46 46.5 46 62H2Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="person">
          <svg viewBox="0 0 48 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="person-head" cx="24" cy="13" r="11" fill="currentColor"/>
            <path class="person-body" d="M2 62C2 46.5 12 30 24 30C36 30 46 46.5 46 62H2Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="person">
          <svg viewBox="0 0 48 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="person-head" cx="24" cy="13" r="11" fill="currentColor"/>
            <path class="person-body" d="M2 62C2 46.5 12 30 24 30C36 30 46 46.5 46 62H2Z" fill="currentColor"/>
          </svg>
        </div>
        <div class="person">
          <svg viewBox="0 0 48 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle class="person-head" cx="24" cy="13" r="11" fill="currentColor"/>
            <path class="person-body" d="M2 62C2 46.5 12 30 24 30C36 30 46 46.5 46 62H2Z" fill="currentColor"/>
          </svg>
        </div>
      </div>
      <div class="problem-foot">
        <p>{t.foot}</p>
        <CircleCta href="#how-it-works" label={t.ctaLabel} dark />
      </div>
    </div>
    <p class="side-note" data-reveal>{t.sideNote}</p>
  </div>
</section>

<style>
  .problem {
    background: var(--reviko-green);
    color: var(--reviko-cream);
    padding: var(--section-space) 0;
  }
  .display-sm { margin-top: 1rem; max-width: 12ch; }
  .people {
    display: flex;
    align-items: flex-end;
    gap: clamp(0.5rem, 2vw, 0.9rem);
    margin: 2.4rem 0;
  }
  .person {
    width: clamp(40px, 4.5vw, 54px);
    height: auto;
    color: rgb(252 249 243 / 0.28);
    display: flex;
    align-items: flex-end;
    transition: transform 0.35s var(--ease-out), color 0.35s var(--ease-out);
  }
  .person svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .problem-foot { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; }
  .problem-foot p { font-size: 1.15rem; max-width: 22rem; }
  .problem-grid { display: grid; gap: 2rem; }
  .side-note {
    align-self: end; justify-self: start;
    border-left: 1px solid rgb(199 249 121 / 0.4);
    padding-left: 1.2rem; color: var(--reviko-lime-soft); max-width: 20rem;
  }
  @media (min-width: 980px) {
    .problem-grid { grid-template-columns: 1.3fr 0.7fr; }
    .side-note { justify-self: end; }
  }
  @media (max-width: 639px) {
    .display-sm { max-width: 14ch; }
    .people { margin: 1.8rem 0; }
    .person { width: clamp(38px, 12vw, 46px); }
    .problem-foot { gap: 1rem; }
    .problem-foot p { font-size: 1rem; }
  }
</style>
