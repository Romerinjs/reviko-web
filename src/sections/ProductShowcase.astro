---
import Eyebrow from "../components/Eyebrow.astro";
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = ui[locale].product;
---

<section class="product" id="product" aria-labelledby="product-title">
  <span class="anchor-alias" id="producto" aria-hidden="true"></span>
  <div class="container product-grid">
    <div>
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h2 id="product-title" class="display-sm" data-lines>
        {t.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h2>
      <p class="sub" data-reveal>{t.sub}</p>
      <dl class="kpis">
        <div data-reveal><dt>{t.kpis[0]}</dt><dd><span data-counter="1432">1,432</span></dd></div>
        <div data-reveal><dt>{t.kpis[1]}</dt><dd><span data-counter="78" data-suffix="%">78%</span></dd></div>
        <div data-reveal><dt>{t.kpis[2]}</dt><dd><span data-counter="4.2" data-decimals="1">4.2</span></dd></div>
      </dl>
    </div>

    <div class="card" data-reveal role="img" aria-label={t.cardLabel}>
      <div class="card-top">
        <p class="card-title">{t.cardTitle}</p>
        <span class="pill">{t.cardPill}</span>
      </div>
      <p class="big"><span data-counter="78" data-suffix="%">78%</span> <small>{t.cardSmall}</small></p>
      <p class="up">↑ +24%</p>
      <div class="bars" data-bars aria-hidden="true">
        <i style="--h: 34%"></i><i style="--h: 44%"></i><i style="--h: 40%"></i><i style="--h: 56%"></i><i style="--h: 62%"></i><i style="--h: 74%"></i><i style="--h: 86%"></i><i style="--h: 100%"></i>
      </div>
      <div class="card-foot">
        <span><b>1,432</b> {t.cardFoot[0]}</span>
        <span><b>78%</b> {t.cardFoot[1]}</span>
        <span><b>4.2</b> {t.cardFoot[2]}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .product { padding: var(--section-space) 0; background: var(--reviko-cream-2); border-block: 1px solid rgb(11 42 29 / 0.1); }
  .sub { margin-top: 1rem; color: var(--reviko-sage); max-width: 30rem; }
  .product-grid { display: grid; gap: 2.5rem; align-items: center; }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
  .kpis div { border-top: 1px solid rgb(11 42 29 / 0.16); padding-top: 0.9rem; }
  .kpis dt { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--reviko-sage); }
  .kpis dd { font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.04em; color: var(--reviko-green); }
  .card {
    background: var(--reviko-card); border: 1px solid rgb(11 42 29 / 0.12);
    border-radius: var(--radius-lg); padding: 1.6rem; box-shadow: var(--shadow-soft);
  }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .card-title { font-weight: 800; color: var(--reviko-green); }
  .pill { font-size: 0.75rem; font-weight: 700; border: 1px solid rgb(11 42 29 / 0.16); padding: 0.35rem 0.7rem; border-radius: 999px; }
  .big { font-size: clamp(2.5rem, 8vw, 3.2rem); font-weight: 800; letter-spacing: -0.05em; color: var(--reviko-green); margin-top: 0.6rem; }
  .big small { font-size: 1rem; font-weight: 600; letter-spacing: 0; color: var(--reviko-sage); }
  .up { display: inline-block; margin-top: 0.4rem; background: var(--reviko-lime); color: var(--reviko-green); font-weight: 800; padding: 0.3rem 0.7rem; border-radius: 999px; }
  .bars { display: flex; align-items: end; gap: 0.5rem; height: 120px; margin-top: 1.2rem; }
  .bars i {
    flex: 1; border-radius: 6px 6px 3px 3px;
    background: var(--reviko-lime-deep); opacity: 0.55;
    height: var(--h); transform-origin: bottom;
  }
  .bars i:last-child { opacity: 1; background: var(--reviko-green); }
  .card-foot { display: flex; gap: 1.4rem; flex-wrap: wrap; margin-top: 1.2rem; color: var(--reviko-sage); font-size: 0.9rem; }
  .card-foot b { color: var(--reviko-green); }
  @media (min-width: 980px) {
    .product-grid { grid-template-columns: 1.05fr 0.95fr; }
  }
  @media (max-width: 639px) {
    .product-grid { gap: 1.8rem; }
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
    .kpis dt { font-size: 0.68rem; letter-spacing: 0.1em; }
    .card { padding: 1.2rem; }
    .card-top { flex-wrap: wrap; gap: 0.65rem; }
    .pill { white-space: nowrap; }
    .bars { gap: 0.35rem; }
    .card-foot { gap: 0.5rem 1rem; }
  }
</style>
