---
import Eyebrow from "../components/Eyebrow.astro";
import ArrowButton from "../components/ArrowButton.astro";
import RewardProgress from "../components/RewardProgress.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import SiteFooter from "../components/SiteFooter.astro";
import type { Locale } from "../i18n/config";
import { APP_SIGNUP_URL, localizedHomeAnchor, localizedPath } from "../i18n/config";
import { ui } from "../i18n/ui";

export interface Props {
  locale?: Locale;
}
const { locale = "es" } = Astro.props;
const t = ui[locale].notFound;
const home = localizedPath("/", locale);
const otherLocale = locale === "es" ? "en" : "es";
const otherHref = locale === "es" ? "/en/404" : "/404";
const digits = "404".split("");
---

<header class="nf-topbar">
  <div class="container nf-topbar-inner">
    <a href={home} class="nf-brand" aria-label={ui[locale].brandHome}>
      <img src="/reviko-la-vuelta.svg" alt="" width="34" height="34" fetchpriority="high" />
      <span class="wordmark">reviko</span>
    </a>
    <div class="nf-topbar-actions">
      <LanguageSwitcher locale={locale} basePath="/404" />
      <a href={APP_SIGNUP_URL} class="btn btn-lime btn-sm">
        <span>{ui[locale].ctaStart}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</header>

<main class="nf on-dark" id="contenido">
  <img
    class="nf-mark"
    src="/reviko-la-vuelta.svg"
    alt=""
    aria-hidden="true"
    loading="eager"
    decoding="async"
    width="480"
    height="480"
  />
  <div class="container nf-grid">
    <div class="nf-copy">
      <div data-nf="eyebrow"><Eyebrow dark>{t.eyebrow}</Eyebrow></div>
      <p class="nf-code" aria-label={t.codeLabel} data-nf="code">
        {digits.map((digit, index) => (
          <span class:list={["digit", index === 2 && "is-accent"]} data-digit>{digit}</span>
        ))}
      </p>
      <h1 class="display-sm nf-title" data-lines>
        {t.title.map((line) => (
          <span class="line"><span>{line}</span></span>
        ))}
      </h1>
      <p class="sub" data-reveal>{t.sub}</p>
      <div class="ctas" data-nf="ctas">
        <ArrowButton href={home} variant="lime" label={t.ctaPrimary} />
        <ArrowButton href={localizedHomeAnchor("pricing", locale)} variant="ghost" dark label={t.ctaSecondary} />
      </div>
      <p class="micro" data-reveal>{t.micro}</p>

      <nav class="quick" aria-label={t.quickTitle} data-nf="quick">
        <p class="quick-title">{t.quickTitle}</p>
        <ul>
          {t.quick.map((item) => (
            <li>
              <a href={localizedHomeAnchor(item.anchor, locale)}>{item.label}</a>
            </li>
          ))}
          <li>
            <a href={otherHref} lang={otherLocale}>{t.langLabel}</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="nf-visual" data-nf="visual">
      <figure class="pass" role="img" aria-label={t.stampsLabel}>
        <div class="pass-head">
          <span class="pass-brand">reviko</span>
          <span class="pass-shop">{t.passShop}</span>
        </div>
        <div class="pass-body">
          <p class="pass-title">{t.passTitle}</p>
          <RewardProgress total={6} filled={5} icon="coffee" label={t.stampsLabel} />
        </div>
        <div class="pass-foot">
          <p class="pass-progress">{t.passProgress}</p>
          <span class="pass-bar"><i></i></span>
        </div>
      </figure>
      <p class="pass-note" data-reveal>{t.passNote}</p>
      <span class="nf-chip chip-a" data-nf="chip">{t.chipA}</span>
      <span class="nf-chip chip-b" data-nf="chip">{t.chipB}</span>
    </div>
  </div>
</main>

<SiteFooter locale={locale} />

<style>
  .nf-topbar {
    position: relative;
    z-index: 3;
    background: var(--reviko-green-deep);
    border-bottom: 1px solid rgb(252 249 243 / 0.08);
  }
  .nf-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-h);
    padding-block: 0.75rem;
  }
  .nf-brand { display: inline-flex; align-items: center; gap: 0.6rem; }
  .nf-brand img { width: 34px; height: 34px; }
  .wordmark {
    font-weight: 800;
    letter-spacing: -0.04em;
    font-size: 1.15rem;
    color: var(--reviko-cream);
  }
  .nf-topbar-actions { display: inline-flex; align-items: center; gap: 1rem; }

  .nf {
    position: relative;
    overflow: clip;
    background: var(--reviko-green-deep);
    color: var(--reviko-cream);
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(3.5rem, 9vw, 7rem);
    min-height: calc(100svh - var(--header-h));
  }
  .nf::before {
    content: "";
    position: absolute;
    inset: -25% -10% auto -10%;
    height: 75%;
    background:
      radial-gradient(40% 60% at 20% 35%, rgb(199 249 121 / 0.2), transparent 70%),
      radial-gradient(38% 55% at 80% 15%, rgb(30 64 48 / 0.95), transparent 72%);
    pointer-events: none;
  }
  .nf-mark {
    position: absolute;
    right: clamp(-140px, -6vw, -40px);
    bottom: -6%;
    width: clamp(240px, 32vw, 460px);
    height: auto;
    aspect-ratio: 1;
    opacity: 0.32;
    pointer-events: none;
    user-select: none;
  }
  .nf-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .nf-code {
    display: flex;
    gap: 0.05em;
    margin: 1.2rem 0 0.2rem;
    font-size: clamp(4.5rem, 16vw, 10rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--reviko-cream);
  }
  .nf-code .digit { display: inline-block; }
  .nf-code .is-accent {
    color: var(--reviko-lime);
    position: relative;
  }
  .nf-code .is-accent::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 8%;
    height: 0.1em;
    background: var(--reviko-lime-deep);
    border-radius: 4px;
    z-index: -1;
  }
  .nf-title { max-width: 13ch; margin-top: 0.4rem; }
  .sub {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: 1.05rem;
    color: rgb(252 249 243 / 0.78);
  }
  .ctas { margin-top: 1.8rem; display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .micro {
    margin-top: 1.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--reviko-lime-soft);
  }

  .quick { margin-top: 2.2rem; }
  .quick-title {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(252 249 243 / 0.5);
  }
  .quick ul {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .quick a {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--reviko-cream);
    border: 1px solid rgb(252 249 243 / 0.22);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.9rem;
    transition: border-color 0.25s var(--ease-out), color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .quick a:hover {
    border-color: var(--reviko-lime);
    color: var(--reviko-lime);
    transform: translateY(-2px);
  }

  .nf-visual { position: relative; justify-self: center; width: 100%; max-width: 26rem; }
  .pass {
    margin: 0;
    background: var(--reviko-card);
    border: 1px solid rgb(11 42 29 / 0.12);
    border-radius: 24px;
    padding: 1.1rem;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .pass-head {
    background: var(--reviko-green);
    color: var(--reviko-cream);
    border-radius: 16px;
    padding: 1rem;
    display: grid;
    gap: 0.15rem;
  }
  .pass-brand { font-weight: 800; letter-spacing: -0.04em; font-size: 1.15rem; }
  .pass-shop { font-size: 0.8rem; opacity: 0.82; }
  .pass-body { padding: 1.1rem 0.2rem 0.6rem; }
  .pass-title {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--reviko-sage);
    margin-bottom: 0.8rem;
  }
  .pass-foot { padding: 0.2rem 0.2rem 0.4rem; display: grid; gap: 0.5rem; }
  .pass-progress { font-size: 0.82rem; font-weight: 700; color: var(--reviko-green); }
  .pass-bar {
    display: block;
    height: 8px;
    border-radius: 99px;
    background: rgb(11 42 29 / 0.1);
    overflow: hidden;
  }
  .pass-bar i {
    display: block;
    height: 100%;
    width: 83%;
    background: var(--reviko-lime-deep);
    border-radius: 99px;
  }
  .pass-note {
    margin-top: 1rem;
    color: rgb(252 249 243 / 0.7);
    font-size: 0.9rem;
    max-width: 24rem;
  }
  .nf-chip {
    position: absolute;
    font-size: 0.75rem;
    font-weight: 800;
    background: var(--reviko-lime);
    color: var(--reviko-green);
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    box-shadow: var(--shadow-soft);
    white-space: nowrap;
  }
  .chip-a { top: -1.2rem; left: -0.6rem; }
  .chip-b {
    bottom: -1.4rem;
    right: -0.4rem;
    background: var(--reviko-cream);
    border: 1px solid rgb(11 42 29 / 0.14);
  }

  @media (min-width: 980px) {
    .nf-grid { grid-template-columns: 1.1fr 0.9fr; }
  }
  @media (max-width: 979px) {
    .nf-chip { font-size: 0.68rem; padding: 0.4rem 0.7rem; }
    .chip-a { left: 0; }
    .chip-b { right: 0; }
  }
  @media (max-width: 639px) {
    .nf-code { font-size: clamp(4rem, 22vw, 6rem); }
    .nf-title { max-width: 12ch; }
    .ctas { flex-direction: column; align-items: flex-start; }
    .micro { font-size: 0.64rem; letter-spacing: 0.18em; }
    .nf-visual { max-width: 22rem; }
  }
</style>
