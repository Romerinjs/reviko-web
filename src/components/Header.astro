---
import type { Locale } from "../i18n/config";
import { ui } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";

export interface Props {
  locale?: Locale;
  basePath?: string;
}

const { locale = "es", basePath = "/" } = Astro.props;
const t = ui[locale];
---

<header class="site-header" id="top">
  <div class="container header-inner">
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-drawer"
      aria-haspopup="dialog"
      aria-label={t.menuOpen}
      data-open-label={t.menuOpen}
      data-close-label={t.menuClose}
    >
      <span></span><span></span><span></span>
    </button>
    <a href={locale === "es" ? "/" : "/en/"} class="brand" aria-label={t.brandHome}>
      <img src="/reviko-la-vuelta.svg" alt="" width="34" height="34" fetchpriority="high" />
      <span class="wordmark">reviko</span>
    </a>
    <nav class="nav" aria-label={t.navLabel}>
      {t.nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <LanguageSwitcher locale={locale} basePath={basePath} />
      <a href="#cta" class="login desktop-action">{t.login}</a>
      <a href="#cta" class="btn btn-primary btn-sm desktop-action">
        <span>{t.ctaStart}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>

  <dialog class="mobile-drawer" id="mobile-drawer" aria-label={t.navLabel}>
    <div class="drawer-head">
      <a href={locale === "es" ? "/" : "/en/"} class="drawer-brand" aria-label={t.brandHome}>
        <img src="/reviko-la-vuelta.svg" alt="" width="30" height="30" />
        <span>reviko</span>
      </a>
      <button class="drawer-close" type="button" aria-label={t.menuClose}>
        <span></span><span></span>
      </button>
    </div>
    <nav class="drawer-nav" aria-label={t.navLabel}>
      {t.nav.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#cta" class="drawer-login">{t.login}</a>
      <a href="#cta" class="btn btn-lime drawer-cta">
        <span>{t.ctaStart}</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 250ms var(--ease-out), box-shadow 250ms, backdrop-filter 250ms;
  }
  .header-inner {
    height: var(--header-h);
    display: grid;
    grid-template-columns: 44px auto minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
  }
  .site-header.is-scrolled {
    background: rgb(252 249 243 / 0.94);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(11 42 29 / 0.1);
    box-shadow: 0 2px 12px rgb(11 42 29 / 0.025);
  }
  .site-header.is-scrolled .header-inner { height: 62px; }
  .menu-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    padding: 0;
    color: var(--reviko-green);
  }
  .menu-btn span {
    display: block;
    width: 23px;
    height: 1.8px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.22s var(--ease-out), opacity 0.16s ease;
  }
  .menu-btn.is-open span:first-child { transform: translateY(6.8px) rotate(45deg); }
  .menu-btn.is-open span:nth-child(2) { opacity: 0; }
  .menu-btn.is-open span:last-child { transform: translateY(-6.8px) rotate(-45deg); }
  .brand { display: inline-flex; align-items: center; gap: 0.45rem; min-width: 0; }
  .brand img { display: block; width: 30px; height: 30px; }
  .wordmark {
    font-size: 1.48rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: var(--reviko-green);
  }
  .nav { display: none; }
  .desktop-action { display: none; }
  .actions { display: flex; align-items: center; justify-self: end; gap: 1rem; }
  .desktop-action { display: none; }
  .login { font-weight: 700; font-size: 0.92rem; color: var(--reviko-green); white-space: nowrap; }
  .btn-sm { padding: 0.7rem 1.1rem; font-size: 0.9rem; white-space: nowrap; }

  .mobile-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    margin: 0;
    width: min(86vw, 360px);
    max-width: 90vw;
    height: 100vh;
    height: 100dvh;
    max-height: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 0;
    padding: calc(1.25rem + env(safe-area-inset-top)) 1.35rem calc(1.5rem + env(safe-area-inset-bottom));
    background: var(--reviko-cream);
    color: var(--reviko-green);
    transform: translateX(-102%);
    transition: transform 0.28s var(--ease-out);
  }
  .mobile-drawer[open] { display: block; }
  .mobile-drawer.is-open { transform: translateX(0); }
  .mobile-drawer::backdrop {
    background: rgb(11 42 29 / 0.36);
    opacity: 0;
    transition: opacity 0.24s ease;
  }
  .mobile-drawer.is-open::backdrop { opacity: 1; }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 2rem; }
  .drawer-brand { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -0.05em; }
  .drawer-brand img { width: 30px; height: 30px; }
  .drawer-close {
    width: 44px;
    height: 44px;
    position: relative;
    display: grid;
    place-items: center;
    border: 1px solid rgb(11 42 29 / 0.14);
    border-radius: 50%;
    background: transparent;
    color: var(--reviko-green);
  }
  .drawer-close span { position: absolute; width: 19px; height: 1.8px; border-radius: 2px; background: currentColor; transform: rotate(45deg); }
  .drawer-close span:last-child { transform: rotate(-45deg); }
  .drawer-nav { display: grid; gap: 0; }
  .drawer-nav > a:not(.drawer-cta) {
    min-height: 52px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgb(11 42 29 / 0.1);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .drawer-nav .drawer-login { margin-top: 1.5rem; border: 0 !important; min-height: 44px; color: var(--reviko-sage); }
  .drawer-nav .drawer-cta { justify-self: start; margin-top: 0.75rem; min-height: 48px; }

  @media (min-width: 1120px) {
    .header-inner { display: flex; justify-content: space-between; gap: 1rem; }
    .brand { flex: none; }
    .brand img { width: 34px; height: 34px; }
    .wordmark { font-size: 1.7rem; }
    .nav { display: flex; align-items: center; gap: clamp(1rem, 1.5vw, 1.8rem); font-weight: 600; font-size: 0.9rem; color: var(--reviko-green); white-space: nowrap; }
    .desktop-action { display: inline-flex; }
    .nav a { opacity: 0.75; transition: opacity 0.2s; }
    .nav a:hover { opacity: 1; }
    .menu-btn { display: none; }
    .actions { gap: 0.9rem; }
    .desktop-action { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-btn span, .mobile-drawer, .mobile-drawer::backdrop { transition-duration: 1ms; }
  }
</style>
